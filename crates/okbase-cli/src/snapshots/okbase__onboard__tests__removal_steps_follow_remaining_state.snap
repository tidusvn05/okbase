    "steps": [
      {
        "id": "remove-agents",
        "kind": "ask",
        "title": "Unregister okbase from the agents",
        "why": "removes only okbase's MCP entries, skills and AGENTS.md blocks, everywhere it was installed",
        "question": "Remove okbase from every agent configuration where it was installed (other settings stay)?",
        "options": [
          {
            "answer": "yes",
            "commands": [
              "okbase agent uninstall --all"
            ]
          },
          {
            "answer": "no",
            "commands": []
          }
        ],
        "writes": [
          "agent configurations"
        ]
      },
      {
        "id": "remove-data",
        "kind": "ask",
        "title": "Delete okbase's index and cache",
        "why": "models, vectors, dictionary and training environment; documents are never touched",
        "question": "Delete okbase's downloaded models, caches and indexes (`okbase clean` shows the sizes)?",
        "options": [
          {
            "answer": "yes",
            "commands": [
              "okbase clean --all --yes"
            ]
          },
          {
            "answer": "no",
            "commands": []
          }
        ],
        "writes": [
          "user cache"
        ]
      },
