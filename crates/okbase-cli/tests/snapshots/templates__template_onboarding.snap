{
  "id": "init",
  "kind": "ask",
  "title": "Start a knowledge base here",
  "why": "the folder is empty: okbase needs markdown documents to work with",
  "question": "This folder is empty. Shall I start a knowledge base here? Tell me what it is about, who will use it, and which languages people ask in. Choose an empty skeleton or one of the templates below (`okbase templates --json` lists them). Templates include fictional English examples, five trial questions and three workflow guides; they do not start a bot or run external actions. If your documents are elsewhere (markdown, PDF, Word), tell me where.",
  "options": [
    {
      "answer": "start with an empty skeleton",
      "commands": [
        "okbase -b empty init --title \"<what it is about>\" --langs <vi,en,…>",
        "okbase -b empty new --type <Type> \"<title>\"   (or follow the okbase-author skill)",
        "okbase -b empty onboard"
      ]
    },
    {
      "answer": "software-project: Develop, maintain and explain a software project using linked architecture, API and delivery knowledge. (for developer, tech-lead)",
      "commands": [
        "okbase -b empty init --template software-project --langs <languages people use>",
        "okbase -b empty get guides/getting-started",
        "okbase -b empty onboard"
      ]
    },
    {
      "answer": "personal-assistant: Keep durable preferences, daily context and project memory usable across assistant sessions. (for individual, developer, leader)",
      "commands": [
        "okbase -b empty init --template personal-assistant --langs <languages people use>",
        "okbase -b empty get guides/getting-started",
        "okbase -b empty onboard"
      ]
    },
    {
      "answer": "project-assistant: Maintain linked tasks, decisions, investigations and evidence-based project reports. (for developer, project-manager, leader)",
      "commands": [
        "okbase -b empty init --template project-assistant --langs <languages people use>",
        "okbase -b empty get guides/getting-started",
        "okbase -b empty onboard"
      ]
    },
    {
      "answer": "infra-ops: Map services to servers and environments, then connect deployments, policies, runbooks and incident evidence. (for devops, sre, tech-lead)",
      "commands": [
        "okbase -b empty init --template infra-ops --langs <languages people use>",
        "okbase -b empty get guides/getting-started",
        "okbase -b empty onboard"
      ]
    },
